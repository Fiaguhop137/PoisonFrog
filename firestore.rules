rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /messages/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'author', 'message', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'author', 'message', 'timestamp'
        ])
        && request.resource.data.author == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 10000
        && request.resource.data.timestamp == request.time;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.author == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid);

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if false;
    }

    match /ponds/{pondId} {

      function canAccess() {
        return signedIn()
          && (
            resource.data.lotus == request.auth.uid
            || (
              resource.data.waterlilies is list
              && request.auth.uid in resource.data.waterlilies
            )
          );
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'name', 'createdAt', 'lotus', 'waterlilies'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'createdAt', 'lotus', 'waterlilies'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64
        && request.resource.data.name == request.resource.data.name.trim()
        && request.resource.data.createdAt == request.time
        && request.resource.data.lotus == request.auth.uid
        && request.resource.data.waterlilies is list
        && request.resource.data.waterlilies.size() == 0;

      allow read: if canAccess();

      allow update: if canAccess()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64
        && request.resource.data.name == request.resource.data.name.trim();

      allow delete: if signedIn()
        && resource.data.lotus == request.auth.uid;
    }
  }
}